---
import "../styles/sponsors.css";
import type { PublicSponsor } from "../lib/event";

interface Props {
  sponsors: PublicSponsor[];
}
const { sponsors } = Astro.props;

const TIER_LABELS: Record<PublicSponsor["tier"], string> = {
  platinum: "Platinum Sponsors",
  gold: "Gold Sponsors",
  silver: "Silver Sponsors",
  bronze: "Bronze Sponsors",
  community: "Community Sponsors",
  media: "Media Partners",
};
const TIER_ORDER: PublicSponsor["tier"][] = ["platinum", "gold", "silver", "bronze", "community", "media"];

const grouped = TIER_ORDER
  .map((tier) => ({ tier, items: sponsors.filter((s) => s.tier === tier) }))
  .filter((g) => g.items.length > 0);
---

{sponsors.length > 0 && (
<section class="sponsors-section" id="sponsors">
  <div class="sponsors-header">
    <h2 class="sponsors-title">Nuestros Sponsors</h2>
    <span class="sponsors-description">
      Gracias a nuestros increíbles patrocinadores que hacen <br />posible el DevFest Cochabamba 2025
    </span>
  </div>

  {grouped.map(({ tier, items }) => (
    <div class="sponsors-tier">
      <h3 class={`tier-title ${tier}`}>{TIER_LABELS[tier]}</h3>
      <div class="sponsors-grid">
        {items.map((sponsor) => {
          const inner = (
            sponsor.logoUrl ? (
              <img src={sponsor.logoUrl} alt={`logo ${sponsor.name}`} loading="lazy" />
            ) : (
              <span class="sponsor-name">{sponsor.name}</span>
            )
          );
          return (
            <div class="sponsor-logo">
              {sponsor.url ? (
                <a href={sponsor.url} target="_blank" rel="noopener noreferrer">{inner}</a>
              ) : inner}
            </div>
          );
        })}
      </div>
    </div>
  ))}
</section>
)}

<style>
  .sponsor-name {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 60px;
    padding: 0 1rem;
    color: #374151;
    font-weight: 600;
  }
</style>
