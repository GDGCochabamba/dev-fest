---
import { Image } from "astro:assets";
import instagramLogo from "../assets/instagramLogo.png";
import youtubeLogo from "../assets/youtubeLogo.png";

const socials = [
  { label: "Instagram", href: "https://www.instagram.com/gdgcochabamba", icon: instagramLogo, size: 44 },
  { label: "YouTube", href: "https://www.youtube.com/@GDGCochabamba", icon: youtubeLogo, size: 52 },
];
---

<footer class="footer">
  <h2 class="df-section-title">Síguenos en nuestras redes sociales</h2>
  <p class="df-section-lead">No te pierdas las últimas noticias y actualizaciones.</p>

  <ul class="social-links">
    {
      socials.map((social) => (
        <li>
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.label}
          >
            <Image src={social.icon} alt="" width={social.size} height={social.size} />
          </a>
        </li>
      ))
    }
  </ul>
</footer>

<style>
  .footer {
    padding: 72px 24px 80px;
    background: #ffffff;
  }

  .social-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .social-links a {
    display: flex;
    border-radius: 12px;
    transition: transform 150ms ease;
  }

  .social-links a:hover {
    transform: scale(1.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .social-links a {
      transition: none;
    }
  }
</style>
