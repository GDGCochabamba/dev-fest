---
import { Image } from "astro:assets";
import community from "../assets/gallery/community.png";
import team from "../assets/gallery/team.png";
import friends from "../assets/gallery/friends.png";
import duo from "../assets/gallery/duo.png";

const photos = [
  { src: community, alt: "La comunidad de GDG Cochabamba junto al logo de GDG", area: "community" },
  { src: duo, alt: "Dos asistentes con sus credenciales del evento", area: "duo" },
  { src: team, alt: "Cuatro asistentes posando frente a un mural", area: "team" },
  { src: friends, alt: "Dos asistentes con tazas del evento", area: "friends" },
];
---

<section class="gallery" aria-label="Fotos de la comunidad">
  <div class="grid">
    {
      photos.map((photo) => (
        <Image
          src={photo.src}
          alt={photo.alt}
          widths={[480, 960]}
          sizes="(max-width: 700px) 100vw, 64vw"
          class={`photo ${photo.area}`}
        />
      ))
    }
  </div>
</section>

<style>
  .gallery {
    padding: 24px;
    background: var(--df-yellow);
  }

  .grid {
    display: grid;
    grid-template-areas:
      "community community duo"
      "team friends duo";
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, minmax(220px, 373px));
    gap: 24px;
    max-width: 1392px;
    margin: 0 auto;
  }

  .grid :global(.photo) {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    border: 3px solid var(--df-text);
    border-radius: 16px;
    object-fit: cover;
  }

  .grid :global(.community) {
    grid-area: community;
  }
  .grid :global(.duo) {
    grid-area: duo;
  }
  .grid :global(.team) {
    grid-area: team;
  }
  .grid :global(.friends) {
    grid-area: friends;
  }

  @media (max-width: 700px) {
    .grid {
      grid-template-areas:
        "community community"
        "team friends"
        "duo duo";
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: 220px 180px 320px;
      gap: 12px;
    }
  }
</style>
