---
interface Props {
  name?: string;
  tagline?: string;
  description?: string;
  coverImageUrl?: string;
}
const { name, tagline, description, coverImageUrl } = Astro.props;
---

<section class="hero" id="inicio">
  {coverImageUrl && (
    <img src={coverImageUrl} alt={name ?? "DevFest"} class="hero-cover" loading="eager" />
  )}
  <div class="hero-text">
    <h1>{name ?? "DevFest Cochabamba"}</h1>
    {tagline && <p class="tagline">{tagline}</p>}
    {description && <p class="description">{description}</p>}
  </div>
</section>

<style>
  .hero {
    padding: 4rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }
  .hero-cover {
    max-width: min(900px, 90%);
    height: auto;
    border-radius: 1rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }
  .hero-text {
    max-width: 720px;
  }
  .hero h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }
  .hero .tagline {
    font-size: 1.25rem;
    color: #1f2937;
    font-weight: 500;
    margin-bottom: 0.75rem;
  }
  .hero .description {
    font-size: 1.05rem;
    color: #4b5563;
    line-height: 1.6;
  }
</style>
