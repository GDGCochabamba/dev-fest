---
import type { PopulatedParticipant } from "../lib/event";

interface Props {
  speakers: PopulatedParticipant[];
}
const { speakers } = Astro.props;

const AVATAR_COLORS = ["#4285f4", "#ea4335", "#f9ab00", "#34a853"];

function initials(name: string): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0])
    .join("")
    .toUpperCase();
}

function colorFor(name: string): string {
  let sum = 0;
  for (const char of name) sum += char.charCodeAt(0);
  return AVATAR_COLORS[sum % AVATAR_COLORS.length];
}

const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

{speakers.length > 0 && (
<section class="speakers" id="speakers">
  <h2 class="speakers-title">Speakers</h2>
  <div class="speakers-grid">
    {speakers.map(({ participant, person }) => {
      const bio = participant.bioOverride ?? person.bio;
      return (
        <article class="speaker-card">
          {person.photoUrl ? (
            <img class="speaker-avatar" src={person.photoUrl} alt={person.name} loading="lazy" />
          ) : (
            <div
              class="speaker-avatar speaker-initials"
              style={`background-color: ${colorFor(person.name)}`}
              aria-hidden="true"
            >
              {initials(person.name)}
            </div>
          )}
          <h3 class="speaker-name">{person.name}</h3>
          {participant.talkTitle && <p class="speaker-talk">{participant.talkTitle}</p>}
          {person.expertise.length > 0 && (
            <ul class="speaker-tags">
              {person.expertise.map((tag) => <li>{capitalize(tag)}</li>)}
            </ul>
          )}
          {bio && <p class="speaker-bio">{bio}</p>}
        </article>
      );
    })}
  </div>
</section>
)}

<style>
  .speakers {
    padding: 3rem 1.5rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .speakers-title {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 2rem;
  }
  .speakers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 1.25rem;
  }
  .speaker-card {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .speaker-card:hover {
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }
  .speaker-avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 0.25rem;
  }
  .speaker-initials {
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.75rem;
    font-weight: 700;
  }
  .speaker-name {
    font-size: 1rem;
    font-weight: 600;
    color: #111827;
    margin: 0;
  }
  .speaker-talk {
    font-size: 0.85rem;
    color: #4285f4;
    font-weight: 500;
    margin: 0;
  }
  .speaker-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .speaker-tags li {
    font-size: 0.75rem;
    background: #e8f0fe;
    color: #1a73e8;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
  }
  .speaker-bio {
    font-size: 0.8rem;
    color: #6b7280;
    line-height: 1.5;
    margin: 0.25rem 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-width: 480px) {
    .speakers-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
    .speaker-card {
      padding: 1rem 0.75rem;
    }
    .speaker-avatar {
      width: 72px;
      height: 72px;
    }
    .speaker-initials {
      font-size: 1.35rem;
    }
  }
</style>
