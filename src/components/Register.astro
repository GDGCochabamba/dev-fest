---
interface Props {
  registrationUrl?: string;
  eventName?: string;
}
const { registrationUrl, eventName } = Astro.props;
---

{registrationUrl && (
<section class="register" id="registro">
  <h2>Inscríbete</h2>
  <p>Asegura tu lugar en {eventName ?? "el evento"}.</p>
  <a href={registrationUrl} target="_blank" rel="noopener noreferrer" class="register-btn">
    Registrarme
  </a>
</section>
)}

<style>
  .register {
    padding: 3rem 1.5rem;
    text-align: center;
    background: #f3f4f6;
  }
  .register h2 {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .register p {
    color: #4b5563;
    margin-bottom: 1.5rem;
  }
  .register-btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: #4285f4;
    color: white;
    text-decoration: none;
    border-radius: 0.5rem;
    font-weight: 600;
    transition: background 0.2s ease;
  }
  .register-btn:hover {
    background: #3367d6;
  }
</style>
